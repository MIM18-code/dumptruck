<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- r3d-probe, braw-probe and arri-probe load vendor libraries signed
         by RED, Blackmagic and ARRI. RED's libraries must ship unmodified,
         so they keep RED's team ID and the helper must accept it. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
